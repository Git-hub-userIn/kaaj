generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String             @id @default(uuid())
  email            String             @unique
  name             String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  categories       Category[]
  entries          Entry[]
  manifests        EntryManifest[]
  chunks           Chunk[]
  assets           AssetMeta[]
  maintenanceState MaintenanceState[]
  leases           JobLease[]
  revisions        EntryRevision[]
}

model Category {
  id           String    @id @default(uuid())
  userId       String    @default("dev-owner-user")
  title        String
  description  String?
  coverAssetId String?
  sortOrder    Int       @default(0)
  color        String?
  todo         Json      @default("[]")
  version      Int       @default(1)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries      Entry[]

  @@index([userId])
  @@index([deletedAt])
  @@index([sortOrder])
}

model Entry {
  id            String         @id @default(uuid())
  userId        String         @default("dev-owner-user")
  categoryId    String
  title         String
  color         String?
  pinned        Boolean        @default(false)
  weight        Int            @default(1)
  sortOrder     Int            @default(0)
  version       Int            @default(1)
  schemaVersion Int            @default(2)
  spine         Json?
  stats         Json?
  lastOpenedAt  DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  manifest      EntryManifest?
  chunks        Chunk[]
  revisions     EntryRevision[]

  @@index([userId])
  @@index([categoryId])
  @@index([deletedAt])
  @@index([sortOrder])
}

model EntryManifest {
  id            String   @id @default(uuid())
  userId        String   @default("dev-owner-user")
  entryId       String   @unique
  schemaVersion Int      @default(2)
  version       Int
  totalBlocks   Int      @default(0)
  chunkCount    Int      @default(0)
  stats         Json?
  chunks        Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry         Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Chunk {
  id         String
  entryId    String
  userId     String   @default("dev-owner-user")
  order      Int      @default(0)
  version    Int      @default(1)
  checksum   String
  bytes      Int      @default(0)
  blockCount Int      @default(0)
  payload    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry      Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@id([entryId, id])
  @@index([userId])
  @@index([entryId])
}

model AssetMeta {
  id           String   @id
  userId       String   @default("dev-owner-user")
  storageKey   String   @unique
  mime         String
  bytes        Int
  width        Int?
  height       Int?
  originalName String?
  checksum     String
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MaintenanceState {
  id              String    @default("singleton")
  userId          String    @default("dev-owner-user")
  lastBackupAt    DateTime?
  lastPruneAt     DateTime?
  lastResult      String?
  lastError       String?
  remoteFileCount Int?
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, id])
  @@index([userId])
}

model JobLease {
  name       String
  userId     String   @default("dev-owner-user")
  holder     String
  token      BigInt   @default(0)
  acquiredAt DateTime
  expiresAt  DateTime
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, name])
  @@index([userId])
}

model EntryRevision {
  id        String   @id @default(uuid())
  userId    String   @default("dev-owner-user")
  entryId   String
  version   Int
  title     String
  manifest  Json
  doc       Json?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry     Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, version])
  @@index([userId])
  @@index([entryId])
}
