{
  "name": "kaaj-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:ui": "bun --filter @kaaj/web dev",
    "dev:web": "bun --filter @kaaj/web dev",
    "dev:api": "bun --filter @kaaj/api dev",
    "dev:backend": "bun --filter @kaaj/api dev",
    "build": "bun run --filter \"*\" build",
    "test:e2e": "bun --filter e2e test",
    "typecheck": "bun run --filter \"*\" typecheck"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0"
  }
}
