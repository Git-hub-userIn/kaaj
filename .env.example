# PostgreSQL Connection URL (admin/base connection)
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"

# Optional Connection Pool Max
PG_POOL_MAX="10"

# Application Mode: dev | test
APP_MODE="dev"

# Backup Target & Drive Folder
BACKUP_TARGET="local"
BACKUP_DRIVE_FOLDER_NAME="Kaaj"

# Auth Seam (Dev token enabled in dev, disabled in prod)
DEV_AUTH_TOKEN="dev-test-token"

# Google OAuth (Optional / existing)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/auth/google/callback"
